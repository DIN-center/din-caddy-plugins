# Caddyfile for Din e2e testing - Handler Registry + AI Smart Routing
{
	debug
	order din before reverse_proxy
	order din_ai before reverse_proxy
}
:8000 {
	# Add health check endpoint
	handle /health {
		respond "OK" 200
	}

	route /* {
		# middleware declaration
		din {
			environment prod
			# Test the new handler registry with multiple network types
			networks {
				# EVM Network (existing functionality)
				eth {
					providers {
						https://eth.llamarpc.com:443 {
							priority 0
						}
						https://ethereum-rpc.publicnode.com:443 {
							priority 1
						}
					}
					chain_id 0x1
				}
			}
		}
		# din reverse proxy directive configuration
		reverse_proxy {
			lb_policy din_reverse_proxy_policy
			transport http {
				tls
				keepalive 10s
			}
			dynamic din_reverse_proxy_policy
			header_up Host {upstream_hostport}
		}
	}
}

:9080 {
	handle /health {
		respond "OK" 200
	}

	route /v1/* {
		din_ai {
			healthcheck_interval 120
			healthcheck_threshold 3
			request_attempt_count 2

			tiers {
				fast {
					providers {
						openai-nano https://api.openai.com/v1/chat/completions {
							model gpt-4.1-nano
							adapter openai
							headers {
								Authorization "Bearer {env.OPENAI_API_KEY}"
							}
						}
						anthropic-haiku https://api.anthropic.com/v1/messages {
							model claude-haiku-4-5-20251001
							adapter anthropic
							headers {
								x-api-key {env.ANTHROPIC_API_KEY}
								anthropic-version 2023-06-01
							}
						}
					}
				}
				balanced {
					providers {
						openai-gpt41 https://api.openai.com/v1/chat/completions {
							model gpt-4.1
							adapter openai
							headers {
								Authorization "Bearer {env.OPENAI_API_KEY}"
							}
						}
						anthropic-sonnet https://api.anthropic.com/v1/messages {
							model claude-sonnet-4-6
							adapter anthropic
							headers {
								x-api-key {env.ANTHROPIC_API_KEY}
								anthropic-version 2023-06-01
							}
						}
					}
				}
			}
		}
	}
}
