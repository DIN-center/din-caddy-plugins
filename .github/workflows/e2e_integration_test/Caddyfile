# Caddyfile for Din e2e testing - Enhanced for Handler Registry Testing
# ${BSC_VALIDATIONCLOUD_KEY1} is fetched from AWS Secrets Manager and
# substituted via envsubst before Caddy reads this file.
{
	debug
	order din before reverse_proxy
}
:8000 {
	# Add health check endpoint
	handle /health {
		respond "OK" 200
	}

	route /* {
		# middleware declaration
		din {
			environment prod
			networks {
				bsc-mainnet {
					request_attempt_count 1
					providers {
						https://mainnet.bsc.validationcloud.io/v1/${BSC_VALIDATIONCLOUD_KEY1} {
							priority 0
						}
					}
					chain_id 0x38
				}
			}
		}
		# din reverse proxy directive configuration
		reverse_proxy {
			lb_policy din_reverse_proxy_policy
			transport http {
				tls
				keepalive 10s
			}
			dynamic din_reverse_proxy_policy
			header_up Host {upstream_hostport}
		}
	}
}
