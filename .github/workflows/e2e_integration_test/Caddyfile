# Caddyfile for Din e2e testing - Enhanced for Handler Registry Testing
# Provider URLs are injected via envsubst before Caddy reads this file.
# ${E2E_ALCHEMY_BSC_URL} is fetched from AWS Secrets Manager in the workflow.
{
	debug
	order din before reverse_proxy
}
:8000 {
	# Add health check endpoint
	handle /health {
		respond "OK" 200
	}

	route /* {
		# middleware declaration
		din {
			environment prod
			# Test the new handler registry with multiple network types
			networks {
				# EVM Network - backed by Alchemy BSC mainnet (authenticated, no rate limits)
				# Network is named "eth" so existing test scripts require no changes.
				eth {
					request_attempt_count 1
					providers {
						${E2E_ALCHEMY_BSC_URL} {
							priority 0
						}
					}
					chain_id 0x38
				}
			}
		}
		# din reverse proxy directive configuration
		reverse_proxy {
			lb_policy din_reverse_proxy_policy
			transport http {
				tls
				keepalive 10s
			}
			dynamic din_reverse_proxy_policy
			header_up Host {upstream_hostport}
		}
	}
}
