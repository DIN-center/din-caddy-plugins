{
  "name": "din-metrics-query",
  "version": "1.0.0",
  "description": "Natural language query interface for DIN infrastructure metrics",
  "main": "dist/metrics-cli.js",
  "scripts": {
    "start": "node dist/metrics-cli.js",
    "metrics": "node dist/metrics-cli.js",
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "ts-node-dev --respawn --transpile-only src/metrics-cli.ts",
    "query": "npm run build && node dist/metrics-cli.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "monitoring",
    "sre",
    "claude",
    "signoz",
    "din"
  ],
  "author": "DIN Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "axios": "^1.6.7",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.1",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "date-fns": "^3.3.1",
    "p-limit": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}