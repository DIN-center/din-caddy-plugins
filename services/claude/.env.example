# SigNoz Configuration
SIGNOZ_API_KEY=your-signoz-api-key
SIGNOZ_BASE_URL=https://your-instance.signoz.cloud
SIGNOZ_ENVIRONMENT=prod

# Claude Configuration
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-opus-20240229

# Monitoring Configuration
POLL_INTERVAL_SECONDS=60
LOG_LEVEL=info
DAILY_REPORT_HOUR=0
DAILY_REPORT_TIMEZONE=UTC

# Error Thresholds
ERROR_THRESHOLD_CRITICAL=0.10
ERROR_THRESHOLD_HIGH=0.05
ERROR_THRESHOLD_MEDIUM=0.02
ERROR_THRESHOLD_LOW=0.01

# Retry Configuration  
MAX_RETRY_ATTEMPTS=5
RETRY_EXHAUSTION_THRESHOLD=3

# Alert Configuration
ALERT_COOLDOWN_MINUTES=15
ALERT_WEBHOOK_URL=

# Archive Mode Detection
ARCHIVE_ERROR_CODE=-32602
ARCHIVE_ERROR_PATTERN=pruned

# JSON-RPC Error Monitoring
JSONRPC_ERROR_MONITORING_ENABLED=true
MONITOR_200_WITH_ERRORS=true