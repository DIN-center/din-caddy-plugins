        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(caddy_http_request_duration_seconds_sum[5m])/rate(caddy_http_request_duration_seconds_count[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
